<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="15.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.app_smartgym.Controller.PlanEntrenamientoController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>


    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnVolver" text="&lt; Volver al Menú" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Planes de Entrenamiento" />

    <GridPane hgap="10" vgap="10">
        <!-- Atributos base (AbstractPlanEntrenamiento) -->
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Duración (Meses):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtDuracion" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Valor Mensual ($):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtValorMensual" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbEstado" prefWidth="150.0" promptText="Seleccione..." GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <!-- Factory selector -->
        <Label text="Tipo de Plan:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cmbTipoPlan" prefWidth="150.0" promptText="Factory..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Atributos específicos del Plan Personalizado -->
        <Label text="Cant. Sesiones:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtCantSesiones" promptText="Solo Personalizado" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Especialidad Req.:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <TextField fx:id="txtEspecialidad" promptText="Solo Personalizado" GridPane.columnIndex="3" GridPane.rowIndex="4" />

        <Label text="Objetivo Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="txtObjetivo" promptText="Solo Personalizado" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.columnSpan="3" />
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnCrear" text="Crear Plan" />
        <Button fx:id="btnActualizar" text="Actualizar" />
        <Button fx:id="btnEliminar" text="Eliminar" />
        <Button fx:id="btnLimpiar" text="Limpiar" />
    </HBox>

    <TableView fx:id="tblPlanes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo (Clase)" />
            <TableColumn fx:id="colDuracion" prefWidth="80.0" text="Meses" />
            <TableColumn fx:id="colValor" prefWidth="100.0" text="Valor/Mes" />
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
        </columns>
    </TableView>
</VBox>