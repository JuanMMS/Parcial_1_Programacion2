<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.app_smartgym.Controller.EntrenadorController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnVolver" text="&lt; Volver al Menú" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Entrenadores" />

    <GridPane hgap="10" vgap="10">
        <Label text="Identificación:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtIdentificacion" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Especialidad:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtEspecialidad" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Tarifa por Sesión ($):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtTarifa" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnCrear" text="Registrar" />
        <Button fx:id="btnActualizar" text="Actualizar" />
        <Button fx:id="btnEliminar" text="Eliminar" />
        <Button fx:id="btnLimpiar" text="Limpiar Campos" />
    </HBox>

    <TableView fx:id="tblEntrenadores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdentificacion" prefWidth="120.0" text="Identificación" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colEspecialidad" prefWidth="150.0" text="Especialidad" />
            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />
            <TableColumn fx:id="colTarifa" prefWidth="150.0" text="Tarifa Sesión" />
        </columns>
    </TableView>
</VBox>