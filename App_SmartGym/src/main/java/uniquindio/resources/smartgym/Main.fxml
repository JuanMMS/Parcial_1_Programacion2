<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.app_smartgym.Controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Sistema de Gestión - SmartGym" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Button fx:id="btnGestionClientes" mnemonicParsing="false" prefWidth="250.0" text="Gestión de Clientes" />
    <Button fx:id="btnGestionEntrenadores" mnemonicParsing="false" prefWidth="250.0" text="Gestión de Entrenadores" />
    <Button fx:id="btnGestionPlanes" mnemonicParsing="false" prefWidth="250.0" text="Gestión de Planes de Entrenamiento" />
    <Button fx:id="btnGestionServicios" mnemonicParsing="false" prefWidth="250.0" text="Gestión de Servicios Adicionales" />
    <Button fx:id="btnGestionInscripciones" mnemonicParsing="false" prefWidth="250.0" text="Gestión de Inscripciones" />
    <Button fx:id="btnCalcularIngresos" mnemonicParsing="false" prefWidth="250.0" text="Calcular Ingresos por Periodo" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
</VBox>