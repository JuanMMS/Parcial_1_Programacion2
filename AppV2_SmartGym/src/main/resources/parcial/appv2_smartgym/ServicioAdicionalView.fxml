<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="700.0" spacing="15.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="parcial.appv2_smartgym.ViewController.ServicioAdicionalViewController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnVolver" text="&lt; Volver al Menú" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Servicios Adicionales" />

    <GridPane hgap="10" vgap="10">
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3" />

        <Label text="Precio ($):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Tipo de Servicio:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbTipo" promptText="Seleccione Enum" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label text="Disponibilidad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <CheckBox fx:id="chkDisponibilidad" text="Disponible" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnCrear" text="Crear" />
        <Button fx:id="btnActualizar" text="Actualizar" />
        <Button fx:id="btnEliminar" text="Eliminar" />
    </HBox>

    <TableView fx:id="tblServicios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            <TableColumn fx:id="colDisponibilidad" prefWidth="100.0" text="Disponible" />
        </columns>
    </TableView>
</VBox>