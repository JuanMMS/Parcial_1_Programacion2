<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="parcial.appv2_smartgym.ViewController.ClienteViewController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Button fx:id="btnVolver" text="&lt; Volver al Menú" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Clientes" />

    <GridPane hgap="10" vgap="10">
        <!-- Fila 0 -->
        <Label text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Documento:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtDocumento" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- Fila 1 -->
        <Label text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtEdad" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <!-- Fila 2 -->
        <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <!-- Botones CRUD -->
    <HBox spacing="10.0">
        <Button fx:id="btnCrear" text="Crear" />
        <Button fx:id="btnActualizar" text="Actualizar" />
        <Button fx:id="btnEliminar" text="Eliminar" />
        <Button fx:id="btnLimpiar" text="Limpiar Campos" />
    </HBox>

    <!-- Requerimientos Específicos del Parcial -->
    <HBox spacing="10.0" style="-fx-background-color: #f1f2f6; -fx-padding: 10;">
        <Label text="Buscar Cliente por Teléfono:" alignment="CENTER"/>
        <TextField fx:id="txtTelefonoBuscar" promptText="Ingrese teléfono..." />
        <Button fx:id="btnBuscarPorTelefono" text="Buscar" />
        <Button fx:id="btnValidarNumeroPerfecto" text="Validar Número Perfecto" />
    </HBox>

    <TableView fx:id="tblClientes" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colDocumento" prefWidth="120.0" text="Documento" />
            <TableColumn fx:id="colEdad" prefWidth="50.0" text="Edad" />
            <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
            <TableColumn fx:id="colCorreo" prefWidth="180.0" text="Correo" />
            <TableColumn fx:id="colFechaRegistro" prefWidth="150.0" text="Fecha Registro" />
        </columns>
    </TableView>
</VBox>